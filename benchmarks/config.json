{
  "mengine_path": "~/mengine/build/mengine",
  "mengine_root": "~/mengine",
  "coq_path": "coqc",
  "lean_path": "lean",
  "coqutil_root": "~/coqutil",
  "results_dir": "results",
  "plots_dir": "plots",
  "default_timeout": 20,
  "max_consecutive_timeouts": 3,
  "max_consecutive_failures": 2,
  "mengine_variants": {
