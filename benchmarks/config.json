    },
    "no_subst_memo": {
      "path": "~/mengine/build/ablations/mengine-no-subst-memo",
      "root": "~/mengine",
      "label": "no substitution memo"
    },
    "no_evar_free_fill": {
      "path": "~/mengine/build/ablations/mengine-no-evar-free-fill",
      "root": "~/mengine",
      "label": "no evar-free fill"
    }
  }
}
