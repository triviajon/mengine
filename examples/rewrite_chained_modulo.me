(* rewrite_chained_modulo.me *)
(* This is an example of rewriting away chained modulos *)

(* Axiomize some basics of natural numbers. *)
Axiom nat : Type.

(* Axiomize modulo as a function with the property that: ((a mod n) mod n) = (a mod n). *)
Axiom mod : forall (_: nat), forall (_: nat), nat.
Lemma mod_mod : forall (a: nat), forall (n: nat), eq nat
    (mod (mod a n) n)
    (mod a n).
Admitted.

Theorem chained_modulo : forall (b: nat), forall (p: nat), eq nat 
    (mod (mod (mod (mod (mod (mod b p) p) p) p) p) p)
    (mod b p).
intro b.
intro p.
(* Note: This notation is temporary *)
rewrite mod_mod with eq.
apply eq_refl.
