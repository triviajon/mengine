Definition id (A: Type) (x: A) : A := x.

Definition compose (A: Type) (B: Type) (C: Type) (f: forall (b: B), C) (g: forall (a: A), B) (x: A) : C := f (g x).

Theorem id_self_proof : forall (P: Prop), forall (p: P), P.
exact id.

Definition const_fn (A: Type) (B: Type) (a: A) : forall (b: B), A := fun (b: B) => a.

Check const_fn.
Check const_fn Type Prop Prop.
