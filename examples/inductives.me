(* inductives.me *)
(* This is a display of using inductive types. *)

Inductive nat : Type := | O : nat | S : forall (_: nat), nat.

Check nat.
Check (S O).
Check nat_ind.

(* Pattern matching with match expressions *)
Definition pred : forall (_: nat), nat :=
  fun (n : nat) =>
    match n with
    | O => O
    | S m => m
    end.

Definition is_zero : forall (_: nat), nat :=
  fun (n : nat) =>
    match n with
    | O => S O
    | S m => O
    end.

Fixpoint add (n : nat) (m : nat) {struct n} : nat := match n with | O => m | S n' => S (add n' m) end.

Print add.

Inductive bool : Type := | true : bool | false : bool.

Definition not : forall (_: bool), bool :=
  fun (b : bool) =>
    match b with
    | true => false
    | false => true
    end.

Fixpoint add2 (n : nat) (m : nat) {struct m} : nat := match m with | O => n | S m' => S (add n m') end.

Print add2.

Fixpoint test (n : nat) (b : bool) {struct b} : nat := match b with | true => n | false => is_zero n end.

Check test O.