{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "mengine",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#vernacular-keywords" },
		{ "include": "#term-keywords" },
		{ "include": "#tactic-keywords" },
		{ "include": "#tactic-combinators" },
		{ "include": "#tactic-primitives" },
		{ "include": "#reduction-flags" },
		{ "include": "#show-keywords" },
		{ "include": "#sorts" },
		{ "include": "#struct-annotation" },
		{ "include": "#pattern-variable" },
		{ "include": "#operators" },
		{ "include": "#dot-terminator" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"name": "comment.block.mengine",
			"begin": "\\(\\*",
			"end": "\\*\\)",
			"patterns": [
				{ "include": "#comments" }
			]
		},
		"vernacular-keywords": {
			"patterns": [
				{
					"name": "keyword.other.vernacular.mengine",
					"match": "\\b(Definition|Theorem|Lemma|Fixpoint|Inductive|Axiom|Variable|Check|Print|Eval|Tactic|Register|Relation)\\b"
				},
				{
					"name": "keyword.other.proof.mengine",
					"match": "\\b(Proof|Admitted|Show|Goal)\\b"
				}
			]
		},
		"term-keywords": {
			"patterns": [
				{
					"name": "keyword.control.mengine",
					"match": "\\b(fun|forall|fix|match|with|end|let|in)\\b"
				}
			]
		},
		"tactic-keywords": {
			"patterns": [
				{
					"name": "support.function.tactic.mengine",
					"match": "\\b(goal_type|type_of|current_goal|mk_hole|fill|subst|eunify|intro_step|pair|fst|snd|app_func|app_arg|expr_eq|rewrite_unify|constr|rewrite|erewrite)\\b"
				}
			]
		},
		"tactic-combinators": {
			"patterns": [
				{
					"name": "keyword.control.tactic.mengine",
					"match": "\\b(try|repeat|first|idtac|fail)\\b"
				}
			]
		},
		"tactic-primitives": {
			"comment": "Built-in primitive tactics parsed by the tactic parser",
			"patterns": [
				{
					"name": "support.function.primitive-tactic.mengine",
					"match": "\\b(cbv|compute)\\b"
				}
			]
		},
		"reduction-flags": {
			"patterns": [
				{
					"name": "constant.language.reduction.mengine",
					"match": "\\b(beta|delta|iota)\\b"
				}
			]
		},
		"show-keywords": {
			"patterns": [
				{
					"name": "keyword.other.show.mengine",
					"match": "\\b(Context|State)\\b"
				}
			]
		},
		"sorts": {
			"patterns": [
				{
					"name": "storage.type.sort.mengine",
					"match": "\\b(Type|Prop)\\b"
				}
			]
		},
		"struct-annotation": {
			"name": "keyword.other.struct.mengine",
			"match": "\\b(struct)\\b"
		},
		"pattern-variable": {
			"match": "(\\?)([_'A-Za-z][_'A-Za-z0-9]*)",
			"captures": {
				"1": { "name": "punctuation.definition.variable.mengine" },
				"2": { "name": "variable.other.pattern.mengine" }
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.mengine",
					"match": ":="
				},
				{
					"name": "keyword.operator.arrow.mengine",
					"match": "=>"
				},
				{
					"name": "keyword.operator.back-arrow.mengine",
					"match": "<-"
				},
				{
					"name": "keyword.operator.turnstile.mengine",
					"match": "\\|-"
				},
				{
					"name": "keyword.operator.orelse.mengine",
					"match": "\\|\\|"
				},
				{
					"name": "keyword.operator.pipe.mengine",
					"match": "\\|"
				},
				{
					"name": "keyword.operator.semicolon.mengine",
					"match": ";"
				}
			]
		},
		"dot-terminator": {
			"name": "punctuation.terminator.mengine",
			"match": "\\."
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.mengine",
					"match": "[_'A-Za-z][_'A-Za-z0-9]*"
				}
			]
		}
	},
	"scopeName": "source.mengine"
}